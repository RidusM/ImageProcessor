APP_NAME=img-processor
APP_VERSION=1.0.0

ENV=local

SERVICE_MAX_FILE_SIZE_MB=32
SERVICE_WORKER_COUNT=4
SERVICE_QUEUE_SIZE=100
SERVICE_MAX_WIDTH=1920
SERVICE_THUMB_SIZE=300
SERVICE_JPEG_QUALITY=90
SERVICE_ENABLE_WATERMARK=true
SERVICE_WATERMARK_PATH=./assets/watermark.png

# Storage (локальное)
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Storage (MinIO - раскомментировать при необходимости)
# STORAGE_TYPE=minio
# STORAGE_MINIO_ENDPOINT=localhost:9000
# STORAGE_MINIO_ACCESS_KEY=minioadmin
# STORAGE_MINIO_SECRET_KEY=minioadmin
# STORAGE_MINIO_BUCKET=images
# STORAGE_MINIO_USE_SSL=false

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

LOGGER_LEVEL=info
LOGGER_FILENAME=./logs/img-processor.log
LOGGER_MAX_SIZE=100
LOGGER_MAX_BACKUPS=3
LOGGER_MAX_AGE=28
LOGGER_COMPRESS=true