ENV=local
APP_NAME=img-processor
APP_VERSION=1.0.0

SERVICE_MAX_FILE_SIZE_MB=32
SERVICE_WATERMARK_PATH=/app/assets/watermark.png
SERVICE_WORKER_COUNT=4
SERVICE_TASK_TIMEOUT=30s
SERVICE_QUEUE_SIZE=100
SERVICE_MAX_WIDTH=1920
SERVICE_THUMB_SIZE=300
SERVICE_JPEG_QUALITY=90
SERVICE_ENABLE_WATERMARK=true

STORAGE_TYPE=minio
STORAGE_PATH=/app/storage

STORAGE_MINIO_ENDPOINT=minio:9000
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_BUCKET=img-processor
STORAGE_MINIO_USE_SSL=false
STORAGE_MINIO_REGION=us-east-1

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_MAX_HEADER_BYTES=1048576

LOGGER_LEVEL=info
LOGGER_FILENAME=/app/logs/img-processor.log
LOGGER_MAX_SIZE=100
LOGGER_MAX_BACKUPS=3
LOGGER_MAX_AGE=28
LOGGER_COMPRESS=true

KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=image-processing
KAFKA_GROUP_ID=img-processor-workers
KAFKA_DLQ_TOPIC=image-processing-dlq
KAFKA_MAX_ATTEMPTS=3
KAFKA_BASE_RETRY_DELAY=500ms
KAFKA_MAX_RETRY_DELAY=5s